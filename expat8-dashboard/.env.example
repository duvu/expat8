# Expat8 dashboard runtime configuration.
# All values are read at request time on the server; none are needed for `npm run build`
# and none are exposed to the browser. Never commit real values.

# Backend API base URL (signed admin calls, health probes, certificate proxy).
BACKEND_BASE_URL=http://localhost:8787

# Signed-request app credential; must match an active entry in the backend's APP_CREDENTIALS_JSON.
APP_CREDENTIAL_APP_ID=expat8-dashboard
APP_CREDENTIAL_SECRET=change-me

# Admin token; must be listed in the backend's ADMIN_API_TOKENS.
ADMIN_TOKEN=change-me

# PostgreSQL connection string for the dashboard's read queries.
# First non-empty of: EXPAT8_DASHBOARD_DATABASE_URL, WEB_ADMIN_DATABASE_URL, DATABASE_URL.
EXPAT8_DASHBOARD_DATABASE_URL=postgres://expat8:change-me@localhost:5432/expat8

# Container listen port (Dockerfile default 3000).
# PORT=3000

# Environment name shown in the header chip (default: Production / Development from NODE_ENV).
# EXPAT8_ENV_LABEL=Staging
