PORT=8787
DATABASE_URL=postgres://expat8:YOUR_DB_PASSWORD@localhost:5432/expat8
LITELLM_BASE_URL=https://your-litellm-host.example.com
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini
DEFAULT_SOURCE_LANGUAGE=vi
DEFAULT_TARGET_LANGUAGE=en
NEW_WORD_TIMEOUT_SECONDS=5
CORS_ALLOWED_ORIGIN=*
APP_CREDENTIALS_JSON=[{"appId":"your-app-id","secret":"<YOUR_APP_SECRET>","status":"active"}]
APP_CREDENTIAL_TIMESTAMP_SKEW_SECONDS=300
APP_CREDENTIAL_NONCE_TTL_SECONDS=300
APP_CREDENTIAL_GET_BODY_LIMIT_BYTES=0
APP_CREDENTIAL_POST_BODY_LIMIT_BYTES=262144
LOG_LEVEL=info
LOG_REDACTION_ENABLED=true
VOCAB_SCHEDULER_ENABLED=true
VOCAB_POOL_MIN_SIZE=1000
VOCAB_FILL_INTERVAL_SECONDS=60
VOCAB_DAILY_GENERATION_COUNT=10
VOCAB_DAILY_GENERATION_HOUR_UTC=0
VOCAB_GENERATION_BATCH_SIZE=100
VOCAB_SCHEDULER_LOCK_TTL_SECONDS=120
# Auth rate limits (requests per minute). IP limit is shared by register and
# sign-in; the per-account limits are keyed by client IP + identifier.
AUTH_RATE_LIMIT_IP=60
AUTH_RATE_LIMIT_REGISTER=10
AUTH_RATE_LIMIT_SIGN_IN=20
# Set only behind a reverse proxy that overwrites X-Forwarded-For
# (true, hop count such as 1, or trusted subnets). Leave false when exposed directly.
TRUST_PROXY=false
# Apply db/migrations on API startup (serialized with an advisory lock).
# Production can instead run `npm run migrate` as an explicit deploy step.
MIGRATE_ON_START=false
