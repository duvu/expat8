PORT=8787
DATABASE_URL=postgres://expat8:YOUR_DB_PASSWORD@localhost:5432/expat8
LITELLM_BASE_URL=https://your-llm-gateway.example.com
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini
# Per-request timeout for the LLM gateway (LiteLLM or OmniRoute, any OpenAI-compatible /v1/chat/completions).
LITELLM_TIMEOUT_MS=120000
# Run the queue worker (articles, passages, submitted words) inside the API process instead of a separate `npm run start:worker` service.
EMBEDDED_WORKER=false
DEFAULT_SOURCE_LANGUAGE=vi
DEFAULT_TARGET_LANGUAGE=en
NEW_WORD_TIMEOUT_SECONDS=5
CORS_ALLOWED_ORIGIN=*
APP_CREDENTIALS_JSON=[{"appId":"your-app-id","secret":"<YOUR_APP_SECRET>","status":"active"}]
APP_CREDENTIAL_TIMESTAMP_SKEW_SECONDS=300
APP_CREDENTIAL_NONCE_TTL_SECONDS=300
APP_CREDENTIAL_GET_BODY_LIMIT_BYTES=0
APP_CREDENTIAL_POST_BODY_LIMIT_BYTES=262144
LOG_LEVEL=info
LOG_REDACTION_ENABLED=true
VOCAB_SCHEDULER_ENABLED=true
VOCAB_POOL_MIN_SIZE=1000
VOCAB_FILL_INTERVAL_SECONDS=60
VOCAB_DAILY_GENERATION_COUNT=10
VOCAB_DAILY_GENERATION_HOUR_UTC=0
VOCAB_GENERATION_BATCH_SIZE=100
VOCAB_SCHEDULER_LOCK_TTL_SECONDS=120
# Auth rate limits (requests per minute). IP limit is shared by register and
# sign-in; the per-account limits are keyed by client IP + identifier.
AUTH_RATE_LIMIT_IP=60
AUTH_RATE_LIMIT_REGISTER=10
AUTH_RATE_LIMIT_SIGN_IN=20
# Set only behind a reverse proxy that overwrites X-Forwarded-For
# (true, hop count such as 1, or trusted subnets). Leave false when exposed directly.
TRUST_PROXY=false
# Apply db/migrations on API startup (serialized with an advisory lock).
# Production can instead run `npm run migrate` as an explicit deploy step.
MIGRATE_ON_START=false

# Per-level word targets for the generation scheduler (largest deficit is generated first)
VOCAB_LEVEL_TARGETS=A1:200,A2:250,B1:300,B2:300,C1:200
VOCAB_MAX_BACKOFF_SECONDS=1800

# OmniRoute throttling shared by every LLM caller (scheduler, article worker, crawler)
LLM_MIN_INTERVAL_MS=3000
LLM_MAX_CONCURRENT=1
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE_MS=15000
LLM_MAX_REQUESTS_PER_HOUR=120
LLM_RESERVED_REQUESTS_PER_HOUR=30

# Internet content crawler (RSS -> LLM grading -> article pipeline). CRAWLER_FEEDS is comma-separated.
CRAWLER_ENABLED=true
CRAWLER_INTERVAL_MINUTES=180
CRAWLER_MAX_ARTICLES_PER_RUN=3
CRAWLER_MIN_ARTICLE_QUALITY=3
# CRAWLER_FEEDS=https://www.newsinlevels.com/feed/,https://feeds.bbci.co.uk/news/technology/rss.xml

# Curated reading collection (speeches, biographies, history from Wikipedia): backfill first, then 1 per interval
CURATED_ENABLED=true
CURATED_INITIAL_COUNT=20
CURATED_BACKFILL_INTERVAL_MINUTES=15
CURATED_INTERVAL_DAYS=7
